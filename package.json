{
  "name": "ad-agency-marketplace",
  "private": true,
  "version": "0.1.0",
  "description": "Advertising Agency Marketplace - connects advertisers with publishers, managed by a central agency",
  "workspaces": [
    "apps/web",
    "worker",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:worker": "npm run dev --workspace worker",
    "build": "npm run build --workspace apps/web && npm run build --workspace worker",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspace worker",
    "db:migrate": "wrangler d1 migrations apply ad-agency-db --local",
    "db:seed": "npm run db:seed --workspace worker",
    "preview": "wrangler dev"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260804.1": true
  },
  "dependencies": {
    "@agency/shared": "^0.1.0"
  }
}
